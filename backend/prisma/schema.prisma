// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon requires a separate direct (non-pooled) connection for migrations
  directUrl = env("DIRECT_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Weekday {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

model Task {
  id                String     @id @default(uuid())
  title             String
  description       String?
  status            TaskStatus @default(TODO)
  order             Int        @default(0)
  dueDate           DateTime?
  reminderEmail     String?
  reminder30Sent    Boolean    @default(false)
  reminder5Sent     Boolean    @default(false)
  reminderDueSent   Boolean    @default(false)
  isRecurring       Boolean    @default(false)
  recurringDays     Weekday[]  @default([])
  recurringTime     String?
  lastRecurredOn    String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status, order])
  @@map("tasks")
}

