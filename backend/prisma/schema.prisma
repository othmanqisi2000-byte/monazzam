// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon requires a separate direct (non-pooled) connection for migrations
  directUrl = env("DIRECT_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Weekday {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum WorkspaceTaskMode {
  SHARED
  OWNER_ASSIGNED_ONLY
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TaskType {
  STANDARD
  OWNER_ASSIGNED
}

model User {
  id                  String            @id @default(uuid())
  name                String
  email               String            @unique
  passwordHash        String
  reminderEmail       String?
  tasks               Task[]
  editedTasks         Task[]            @relation("TaskLastEditedBy")
  movedTasks          Task[]            @relation("TaskLastMovedBy")
  assignedTasks       Task[]            @relation("TaskAssignee")
  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces     Workspace[]       @relation("WorkspaceOwner")
  sentWorkspaceInvites WorkspaceInvite[] @relation("WorkspaceInviteSender")
  receivedWorkspaceInvites WorkspaceInvite[] @relation("WorkspaceInviteRecipient")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("users")
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  ownerId   String
  taskMode  WorkspaceTaskMode @default(SHARED)
  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
  tasks     Task[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String                @id @default(uuid())
  workspaceId String
  inviterId   String
  inviteeId   String
  status      WorkspaceInviteStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter     User                  @relation("WorkspaceInviteSender", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User                  @relation("WorkspaceInviteRecipient", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, inviteeId])
  @@index([inviteeId, status])
  @@index([workspaceId, status])
  @@map("workspace_invites")
}

model Task {
  id              String     @id @default(uuid())
  userId          String?
  user            User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assigneeId      String?
  assignee        User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignmentGroupId String?
  workspaceId     String?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lastEditedById  String?
  lastEditedBy    User?      @relation("TaskLastEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)
  lastEditedByName String?
  lastEditedAt    DateTime?
  lastMovedById   String?
  lastMovedBy     User?      @relation("TaskLastMovedBy", fields: [lastMovedById], references: [id], onDelete: SetNull)
  lastMovedByName String?
  lastMovedAt     DateTime?
  title           String
  description     String?
  taskType        TaskType   @default(STANDARD)
  status          TaskStatus @default(TODO)
  order           Int        @default(0)
  dueDate         DateTime?
  reminderEmail   String?
  reminder30Sent  Boolean    @default(false)
  reminder5Sent   Boolean    @default(false)
  reminderDueSent Boolean    @default(false)
  isRecurring     Boolean    @default(false)
  recurringDays   Weekday[]  @default([])
  recurringTime   String?
  lastRecurredOn  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([workspaceId, status, order])
  @@index([workspaceId, taskType, assigneeId, status, order])
  @@index([workspaceId, assignmentGroupId])
  @@map("tasks")
}
