# Neon PostgreSQL connection strings
# DATABASE_URL -> pooled connection (used by the running app, via PgBouncer)
# DIRECT_URL   -> direct connection (used by Prisma Migrate, no pooling)
#
# Get both from your Neon dashboard: Project -> Connection Details
# Make sure DATABASE_URL includes "?sslmode=require&pgbouncer=true"
# and DIRECT_URL includes "?sslmode=require"

DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.neon.tech/<dbname>?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require"

PORT=5000
CLIENT_ORIGIN="http://localhost:5173"
AUTH_SECRET="replace-with-a-long-random-secret"

# Gmail API OAuth2 settings for task reminder emails.
# You need a Google Cloud OAuth client, plus a refresh token with Gmail send scope.
GMAIL_CLIENT_ID="your-google-oauth-client-id"
GMAIL_CLIENT_SECRET="your-google-oauth-client-secret"
GMAIL_REFRESH_TOKEN="your-google-oauth-refresh-token"
GMAIL_SENDER_EMAIL="Your Name <yourname@gmail.com>"
